{
  "model": {
    "kind": "csr",
    "dir": "goldens/stage0/haldane/operators",
    "label": "haldane",
    "operators": ["VX", "VY"]
  },
  "basis": {
    "name": "real"
  },
  "metric": {
    "policy": "orthogonal"
  },
  "word": "Tr[VX delta(E-H) VY dG-(E)/dE]",
  "expansion": {
    "moments": 128,
    "window": [-4.5, 4.5],
    "trace": "exact"
  },
  "reconstruction": {
    "kernel": "jackson",
    "broadening_meV": 50.0,
    "formulas": ["bastin", "sea", "surf", "bastin_fft"],
    "fft_grid": true
  },
  "output": {
    "dir": "out/bastin_split",
    "legacy_layout": true,
    "write_chebmom": true
  }
}
