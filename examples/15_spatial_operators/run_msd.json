{
  "model": {
    "kind": "csr",
    "dir": "examples/15_spatial_operators/operators",
    "label": "bilayer_L4096",
    "operators": ["VX"]
  },
  "basis": {
    "name": "real"
  },
  "metric": {
    "policy": "orthogonal"
  },
  "word": "Tr[[X,U(t)]^+ delta(E-H) [X,U(t)]]",
  "words": [
    "Tr[[X,U(t)]^+ delta(E-H) [X,U(t)]]",
    "Tr[delta(E-H)]"
  ],
  "expansion": {
    "moments": 256,
    "window": [-3.0, 3.0],
    "trace": "random",
    "states": 2,
    "seed": 1
  },
  "time": {
    "steps": 41,
    "tmax": 40.0
  },
  "reconstruction": {
    "kernel": "jackson",
    "broadening_meV": 60.0,
    "fermi_energies": [0.0, 1.0],
    "formulas": ["time_correlation", "dos"]
  },
  "output": {
    "dir": "out/msd",
    "legacy_layout": true
  }
}
