# hBN monolayer, PBE, DZP. Same cell and positions as qe/.
SystemName        hBN monolayer
SystemLabel       hbn
NumberOfAtoms     2
NumberOfSpecies   2
%block ChemicalSpeciesLabel
  1  5  B
  2  7  N
%endblock ChemicalSpeciesLabel
LatticeConstant   1.0 Ang
%block LatticeVectors
   2.504000  0.000000  0.000000
  -1.252000  2.168528  0.000000
   0.000000  0.000000 20.000000
%endblock LatticeVectors
AtomicCoordinatesFormat  Fractional
%block AtomicCoordinatesAndAtomicSpecies
  0.333333333333  0.666666666667  0.5  1
  0.666666666667  0.333333333333  0.5  2
%endblock AtomicCoordinatesAndAtomicSpecies
PAO.BasisSize     DZP
PAO.EnergyShift   0.005 Ry
XC.functional     GGA
XC.authors        PBE
MeshCutoff        400 Ry
%block kgrid_Monkhorst_Pack
  24  0  0  0.0
   0 24  0  0.0
   0  0  1  0.0
%endblock kgrid_Monkhorst_Pack
DM.Tolerance      1.d-6
SCF.H.Tolerance   1.d-5 eV
MaxSCFIterations  200
SaveHS            true
