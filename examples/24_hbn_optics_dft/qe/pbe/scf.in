&CONTROL
  calculation = 'scf'
  prefix = 'hbn'
  outdir = './tmp'
  pseudo_dir = '../../pseudo'
/
&SYSTEM
  ibrav = 0
  nat = 2, ntyp = 2
  ecutwfc = 90
  nbnd = 40
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1e-10
/
