{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "golden",
      "displayName": "Golden (portable IEEE)",
      "description": "Portable IEEE build profile without machine-specific or fast-math flags",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/golden",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LSQUANT_BUILD_PROFILE": "golden",
        "LSQUANT_BUILD_PYTHON": "ON",
        "LSQUANT_BUILD_DEV_CHECKS": "ON",
        "LSQUANT_BUILD_BENCHMARKS": "OFF",
        "LSQUANT_BUILD_INPUT_TOOLS": "OFF"
      }
    },
    {
      "name": "native",
      "displayName": "Native (SIMD + NUMA + cache-blocked)",
      "description": "Host-tuned build profile (-O3 -march=native -mtune=native -fno-math-errno, LSQUANT_NATIVE_BUILD=1)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LSQUANT_BUILD_PROFILE": "native",
        "LSQUANT_BUILD_PYTHON": "ON",
        "LSQUANT_BUILD_DEV_CHECKS": "ON",
        "LSQUANT_BUILD_BENCHMARKS": "OFF",
        "LSQUANT_BUILD_INPUT_TOOLS": "OFF"
      }
    },
    {
      "name": "native-mpi",
      "displayName": "Native + MPI",
      "description": "Native profile with the MPI distributed operator (LSQUANT_WITH_MPI=ON)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/native-mpi",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LSQUANT_BUILD_PROFILE": "native",
        "LSQUANT_BUILD_PYTHON": "ON",
        "LSQUANT_BUILD_DEV_CHECKS": "ON",
        "LSQUANT_BUILD_BENCHMARKS": "OFF",
        "LSQUANT_WITH_MPI": "ON"
      }
    },
    {
      "name": "native-cuda",
      "displayName": "Native + CUDA",
      "description": "Native profile with the CUDA atom-block kernel (LSQUANT_WITH_CUDA=ON)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/native-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LSQUANT_BUILD_PROFILE": "native",
        "LSQUANT_BUILD_PYTHON": "ON",
        "LSQUANT_BUILD_DEV_CHECKS": "ON",
        "LSQUANT_BUILD_BENCHMARKS": "OFF",
        "LSQUANT_WITH_CUDA": "ON"
      }
    },
    {
      "name": "full",
      "displayName": "Native + MPI + CUDA",
      "description": "Native profile with both the MPI distributed operator and the CUDA atom-block kernel",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LSQUANT_BUILD_PROFILE": "native",
        "LSQUANT_BUILD_PYTHON": "ON",
        "LSQUANT_BUILD_DEV_CHECKS": "ON",
        "LSQUANT_BUILD_BENCHMARKS": "OFF",
        "LSQUANT_WITH_MPI": "ON",
        "LSQUANT_WITH_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "golden",
      "configurePreset": "golden",
      "jobs": 8
    },
    {
      "name": "native",
      "configurePreset": "native",
      "jobs": 8
    },
    {
      "name": "native-mpi",
      "configurePreset": "native-mpi",
      "jobs": 8
    },
    {
      "name": "native-cuda",
      "configurePreset": "native-cuda",
      "jobs": 8
    },
    {
      "name": "full",
      "configurePreset": "full",
      "jobs": 8
    }
  ]
}
